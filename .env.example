# API-Football â€” direct (dashboard.api-football.com)
API_FOOTBALL_KEY=your_api_football_key_here

# API-Football via RapidAPI (api-football-v1.p.rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here

# Set to "direct" or "rapidapi"
API_FOOTBALL_HOST=direct

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://lohela:lohela_pass@localhost:5432/lohela

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
SECRET_KEY=change_me_in_production
# Required for state-changing research/admin API calls outside local development.
RESEARCH_API_KEY=replace_with_a_long_random_value
LOG_LEVEL=INFO

# Pipeline schedule (stored as UTC; displayed as CAT = UTC+2)
PIPELINE_EARLY_CRON_HOUR=22
PIPELINE_EARLY_CRON_MINUTE=15
PIPELINE_MORNING_CRON_HOUR=3
PIPELINE_MORNING_CRON_MINUTE=0
PIPELINE_STARTUP_CATCHUP_ENABLED=true
PIPELINE_WATCHDOG_INTERVAL_MINUTES=5
PIPELINE_STALE_AFTER_MINUTES=45
PIPELINE_AUTOMATIC_RETRY_LIMIT=2

# Automatic result refresh and settlement
SETTLEMENT_INTERVAL_MINUTES=10
SETTLEMENT_LOOKBACK_DAYS=7
SETTLEMENT_STARTUP_LOOKBACK_DAYS=30
SCHEDULER_LEADER_LOCK_ENABLED=true
SCHEDULER_LEADER_LOCK_NAME=lohela:apscheduler:leader

# Weekly no-lookahead shadow learning (never auto-promotes)
LEARNING_SHADOW_SCHEDULE_ENABLED=true

# "analytical" (default): fast, deterministic MAP estimate â€” matters for the
# backtester's reproducibility guarantee. "advi": real PyMC variational
# inference, much slower and not bit-for-bit reproducible run to run.
BAYESIAN_ESTIMATION_METHOD=analytical
